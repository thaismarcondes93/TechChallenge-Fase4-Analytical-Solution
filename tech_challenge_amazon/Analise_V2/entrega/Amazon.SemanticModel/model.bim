          },
          {
            "name": "n_palavras",
            "dataType": "int64",
            "sourceColumn": "n_palavras",
            "summarizeBy": "none"
          },
          {
            "name": "palavras_positivas",
            "dataType": "int64",
            "sourceColumn": "palavras_positivas",
            "summarizeBy": "none"
          },
          {
            "name": "palavras_negativas",
            "dataType": "int64",
            "sourceColumn": "palavras_negativas",
            "summarizeBy": "none"
          },
          {
            "name": "tem_comentario",
            "dataType": "int64",
            "sourceColumn": "tem_comentario",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Fato_Produto",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Csv.Document(File.Contents(PastaDados & \"\\Fato_Produto.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"product_id\", type text}, {\"product_name\", type text}, {\"category\", type text}, {\"categoria_nivel1\", type text}, {\"categoria_nivel2\", type text}, {\"categoria_folha\", type text}, {\"faixa_desconto\", type text}, {\"faixa_preco\", type text}, {\"about_product\", type text}, {\"rotulo_produto\", type text}, {\"review_title\", type text}, {\"grupo_nota\", type text}, {\"grupo_engajamento\", type text}, {\"quadrante\", type text}, {\"actual_price\", type number}, {\"discounted_price\", type number}, {\"desconto_valor\", type number}, {\"discount_percentage\", type number}, {\"rating\", type number}, {\"rating_ajustado\", type number}, {\"saldo_sentimento\", type number}, {\"rating_count\", Int64.Type}, {\"linhas_origem\", Int64.Type}, {\"ordem_desconto\", Int64.Type}, {\"tem_descricao\", Int64.Type}, {\"n_palavras\", Int64.Type}, {\"palavras_positivas\", Int64.Type}, {\"palavras_negativas\", Int64.Type}, {\"tem_comentario\", Int64.Type}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Produtos",
            "expression": "DISTINCTCOUNT(Fato_Produto[product_id])",
            "formatString": "#,0"
          },
          {
            "name": "Categorias",
            "expression": "DISTINCTCOUNT(Fato_Produto[categoria_nivel1])",
            "formatString": "#,0"
          },
          {
            "name": "Avaliações",
            "expression": "SUM(Fato_Produto[rating_count])",
            "formatString": "#,0"
          },
          {
            "name": "Nota média",
            "expression": "AVERAGE(Fato_Produto[rating])",
            "formatString": "0.00"
          },
          {
            "name": "Nota ponderada",
            "expression": "VAR P = FILTER(Fato_Produto, NOT ISBLANK(Fato_Produto[rating]) && NOT ISBLANK(Fato_Produto[rating_count])) RETURN DIVIDE(SUMX(P, Fato_Produto[rating] * Fato_Produto[rating_count]), SUMX(P, Fato_Produto[rating_count]))",
            "formatString": "0.00"
          },
          {
            "name": "Desconto médio",
            "expression": "AVERAGE(Fato_Produto[discount_percentage])",
            "formatString": "0.0%"
          },
          {
            "name": "Preço original médio",
            "expression": "AVERAGE(Fato_Produto[actual_price])",
            "formatString": "₹ #,0.00"
          },
          {
            "name": "Preço final médio",
            "expression": "AVERAGE(Fato_Produto[discounted_price])",
            "formatString": "₹ #,0.00"
          },
          {
            "name": "Avaliações medianas",
            "expression": "MEDIAN(Fato_Produto[rating_count])",
            "formatString": "#,0"
          },
          {
            "name": "Nota ajustada média",
            "expression": "AVERAGE(Fato_Produto[rating_ajustado])",
            "formatString": "0.00"
          },
          {
            "name": "Alertas",
            "expression": "CALCULATE([Produtos], KEEPFILTERS(Fato_Produto[quadrante] = \"Alerta\"))",
            "formatString": "#,0"
          },
          {
            "name": "Estrelas",
            "expression": "CALCULATE([Produtos], KEEPFILTERS(Fato_Produto[quadrante] = \"Estrela\"))",
            "formatString": "#,0"
          },
          {
            "name": "Joias escondidas",
            "expression": "CALCULATE([Produtos], KEEPFILTERS(Fato_Produto[quadrante] = \"Joia escondida\"))",
            "formatString": "#,0"
          },
          {
            "name": "Correlação desconto e nota",
            "expression": "VAR Pares = FILTER(Fato_Produto, NOT ISBLANK(Fato_Produto[discount_percentage]) && NOT ISBLANK(Fato_Produto[rating])) VAR X = AVERAGEX(Pares, Fato_Produto[discount_percentage]) VAR Y = AVERAGEX(Pares, Fato_Produto[rating]) RETURN DIVIDE(SUMX(Pares, (Fato_Produto[discount_percentage] - X) * (Fato_Produto[rating] - Y)), SQRT(SUMX(Pares, (Fato_Produto[discount_percentage] - X)^2) * SUMX(Pares, (Fato_Produto[rating] - Y)^2)))",
            "formatString": "0.000"
          }
        ]
      },
      {
        "name": "Fato_ProdutoTema",
        "columns": [
          {
            "name": "product_id",
            "dataType": "string",
            "sourceColumn": "product_id",
            "summarizeBy": "none"
          },
          {
            "name": "tema",
            "dataType": "string",
            "sourceColumn": "tema",
            "summarizeBy": "none"
          },
          {
            "name": "mencoes",
            "dataType": "int64",
            "sourceColumn": "mencoes",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Fato_ProdutoTema",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Csv.Document(File.Contents(PastaDados & \"\\Fato_ProdutoTema.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"product_id\", type text}, {\"tema\", type text}, {\"mencoes\", Int64.Type}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Menções",
            "expression": "SUM(Fato_ProdutoTema[mencoes])",
            "formatString": "#,0"
          },
          {
            "name": "Menções por mil palavras",
            "expression": "DIVIDE(1000 * [Menções], SUM(Fato_Produto[n_palavras]))",
            "formatString": "0.00"
          },
          {
            "name": "Nota alta por mil",
            "expression": "CALCULATE([Menções por mil palavras], KEEPFILTERS(Fato_Produto[grupo_nota] = \"Alta\"))",
            "formatString": "0.00"
          },
          {
            "name": "Nota baixa por mil",
            "expression": "CALCULATE([Menções por mil palavras], KEEPFILTERS(Fato_Produto[grupo_nota] = \"Baixa\"))",
            "formatString": "0.00"
          }
        ]
      },
      {
        "name": "Dim_Tema",
        "columns": [
          {
            "name": "tema",
            "dataType": "string",
            "sourceColumn": "tema",
            "summarizeBy": "none"
          },
          {
            "name": "palavras_chave",
            "dataType": "string",
            "sourceColumn": "palavras_chave",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Dim_Tema",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Csv.Document(File.Contents(PastaDados & \"\\Dim_Tema.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"tema\", type text}, {\"palavras_chave\", type text}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "Parametros",
        "columns": [
          {
