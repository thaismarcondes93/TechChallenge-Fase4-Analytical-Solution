          },
          {
            "name": "discount_percentage",
            "dataType": "double",
            "sourceColumn": "discount_percentage",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "rating",
            "dataType": "double",
            "sourceColumn": "rating",
            "summarizeBy": "none",
            "formatString": "0.0"
          },
          {
            "name": "rating_ajustado",
            "dataType": "double",
            "sourceColumn": "rating_ajustado",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "saldo_sentimento",
            "dataType": "double",
            "sourceColumn": "saldo_sentimento",
