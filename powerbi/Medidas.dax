// Crie estas medidas na tabela Fato_Produto.

// Formato #,0
Produtos =
DISTINCTCOUNT(Fato_Produto[product_id])

// Formato #,0
Categorias =
DISTINCTCOUNT(Fato_Produto[categoria_nivel1])

// Formato #,0
Avaliações =
SUM(Fato_Produto[rating_count])

// Formato 0.00
Nota média =
AVERAGE(Fato_Produto[rating])

// Formato 0.00
Nota ponderada =
VAR P = FILTER(Fato_Produto, NOT ISBLANK(Fato_Produto[rating]) && NOT ISBLANK(Fato_Produto[rating_count])) RETURN DIVIDE(SUMX(P, Fato_Produto[rating] * Fato_Produto[rating_count]), SUMX(P, Fato_Produto[rating_count]))

// Formato 0.0%
Desconto médio =
AVERAGE(Fato_Produto[discount_percentage])

// Formato ₹ #,0.00
Preço original médio =
AVERAGE(Fato_Produto[actual_price])

// Formato ₹ #,0.00
Preço final médio =
AVERAGE(Fato_Produto[discounted_price])

// Formato #,0
Avaliações medianas =
MEDIAN(Fato_Produto[rating_count])

// Formato 0.00
Nota ajustada média =
AVERAGE(Fato_Produto[rating_ajustado])

// Formato #,0
Alertas =
CALCULATE([Produtos], KEEPFILTERS(Fato_Produto[quadrante] = "Alerta"))

// Formato #,0
Estrelas =
CALCULATE([Produtos], KEEPFILTERS(Fato_Produto[quadrante] = "Estrela"))

// Formato #,0
Joias escondidas =
CALCULATE([Produtos], KEEPFILTERS(Fato_Produto[quadrante] = "Joia escondida"))

// Formato 0.000
Correlação desconto e nota =
VAR Pares = FILTER(Fato_Produto, NOT ISBLANK(Fato_Produto[discount_percentage]) && NOT ISBLANK(Fato_Produto[rating])) VAR X = AVERAGEX(Pares, Fato_Produto[discount_percentage]) VAR Y = AVERAGEX(Pares, Fato_Produto[rating]) RETURN DIVIDE(SUMX(Pares, (Fato_Produto[discount_percentage] - X) * (Fato_Produto[rating] - Y)), SQRT(SUMX(Pares, (Fato_Produto[discount_percentage] - X)^2) * SUMX(Pares, (Fato_Produto[rating] - Y)^2)))

// Crie estas medidas na tabela Fato_ProdutoTema.

// Formato #,0
Menções =
SUM(Fato_ProdutoTema[mencoes])

// Formato 0.00
Menções por mil palavras =
DIVIDE(1000 * [Menções], SUM(Fato_Produto[n_palavras]))

// Formato 0.00
Nota alta por mil =
CALCULATE([Menções por mil palavras], KEEPFILTERS(Fato_Produto[grupo_nota] = "Alta"))

// Formato 0.00
Nota baixa por mil =
CALCULATE([Menções por mil palavras], KEEPFILTERS(Fato_Produto[grupo_nota] = "Baixa"))

// Use como filtro visual da tabela de contexto: valor igual a 1.
// Permite que o filtro de tema restrinja os produtos exibidos sem usar relações bidirecionais.
Exibir produto do tema =
IF(
    ISFILTERED(Dim_Tema[tema]),
    IF([Menções] > 0, 1, 0),
    1
)
